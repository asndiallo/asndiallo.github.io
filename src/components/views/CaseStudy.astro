---
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import { SITE_URL } from "../../config.ts";
import { getDictionary, staticRoutes } from "../../i18n/index.ts";
import Page from "../../layouts/Page.astro";
import { entryAlternates, entryLocale, entryPath } from "../../lib/content.ts";
import CtaWhatsApp from "../CtaWhatsApp.astro";
import Link from "../Link.astro";

interface Props {
  entry: CollectionEntry<"work">;
}
const { entry } = Astro.props;
const { business, location, summary, website, services, results, quote, image, status, disclosure } =
  entry.data;
const locale = entryLocale(entry);
const t = getDictionary(locale);
const { Content } = await render(entry);
const alternates = await entryAlternates("work", entry);
// When every result has the same source, say it once under the list instead of under each number.
const sources = [...new Set(results.map((r) => r.source))];
const sharedSource = sources.length === 1 ? sources[0] : undefined;

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t.caseStudy.home, item: new URL(staticRoutes.home[locale], SITE_URL).href },
    { "@type": "ListItem", position: 2, name: t.work.h1, item: new URL(staticRoutes.work[locale], SITE_URL).href },
    { "@type": "ListItem", position: 3, name: business, item: new URL(entryPath("work", entry), SITE_URL).href },
  ],
};
---

<Page
  title={t.caseStudy.metaTitle(business).slice(0, 60)}
  description={summary}
  h1={t.caseStudy.title(business, location)}
  lead={summary}
  locale={locale}
  alternates={alternates}
  ogType="article"
  jsonLd={[breadcrumbs]}
>
  {disclosure && <p class="measure mt-3 text-muted" data-disclosure>{disclosure}</p>}
  <p class="mt-2 text-sm"><a href={staticRoutes.work[locale]}>{t.caseStudy.all}</a></p>
  {
    image && (
      <Image
        src={image.src}
        alt={image.alt}
        widths={[640, 1280]}
        sizes="(min-width: 1024px) 960px, 100vw"
        loading="eager"
        class="mt-10 w-full max-w-4xl rounded-2xl border border-line"
      />
    )
  }
  <div class="mt-10 grid gap-10 lg:grid-cols-[2fr_1fr]">
    <div class="prose">
      <Content />
      {status === "in-progress" && <p class="rounded-2xl border-2 border-dashed border-line p-4">{t.caseStudy.inProgressNote}</p>}
    </div>
    <!-- Results first: above the story on phones, in the sidebar on wide screens. -->
    <aside
      class="order-first space-y-6 self-start rounded-2xl bg-wash p-6 lg:order-none"
      aria-label={t.caseStudy.facts}
    >
      {
        status === "in-progress" && (
          <p data-status="in-progress" class="inline-block rounded-full bg-sun/25 px-3 py-0.5 text-sm font-semibold">
            {t.caseStudy.inProgress}
          </p>
        )
      }
      {
        results.length > 0 && (
          <div>
            <h2 class="text-lg">{t.caseStudy.results}</h2>
            <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-3">
              {results.map((r) => (
                <div>
                  <dt class="text-sm text-muted">{r.label}</dt>
                  <dd class="font-serif text-2xl font-bold">{r.value}</dd>
                  {!sharedSource && (
                    <dd class="text-xs text-muted">
                      {t.caseStudy.source}{t.colon} {r.source}
                    </dd>
                  )}
                </div>
              ))}
            </dl>
            {sharedSource && (
              <p class="mt-3 text-xs text-muted">
                {t.caseStudy.source}{t.colon} {sharedSource}
              </p>
            )}
          </div>
        )
      }
      <div>
        <h2 class="text-lg">{t.caseStudy.services}</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5">{services.map((s) => <li>{s}</li>)}</ul>
      </div>
      {website && <p><Link href={website}>{t.caseStudy.visit(business)}</Link></p>}
    </aside>
  </div>
  {
    quote && (
      <figure class="measure mt-12 border-l-8 border-sun pl-6">
        <blockquote class="font-serif text-2xl">“{quote.text}”</blockquote>
        <figcaption class="mt-2 text-muted">{quote.author}</figcaption>
      </figure>
    )
  }
  <div class="mt-12"><CtaWhatsApp t={t} /></div>
</Page>
