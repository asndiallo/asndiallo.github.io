---
import type { Dictionary } from "../i18n/en.ts";

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<header class="border-b border-line">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
    <a href="/" class="font-serif text-xl font-bold text-ink no-underline hover:text-brand">Assane Diallo</a>
    <nav aria-label={t.nav.label}>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-[0.95rem]">
        <li><a href="/work/">{t.nav.work}</a></li>
        <li><a href="/about/">{t.nav.about}</a></li>
        <li><a href="/#contact">{t.nav.contact}</a></li>
      </ul>
    </nav>
  </div>
</header>
