---
import { type Dictionary, type Locale, staticRoutes } from "../../i18n/index.ts";
import { getLocalized } from "../../lib/content.ts";
import CaseStudyCard from "../CaseStudyCard.astro";
import Section from "../Section.astro";

interface Props {
  t: Dictionary;
  locale: Locale;
}
const { t, locale } = Astro.props;
const { proof } = t.home;
// Only real proof on the home page: case studies with approved results, never empty slots.
const entries = (await getLocalized("work", locale))
  .filter((e) => e.data.homepage && e.data.results.length > 0)
  .slice(0, 3);
const featured = entries.length === 1 ? entries[0] : undefined;
---

<Section id="proof" heading={proof.h2}>
  <p class="measure mt-4 text-lg">{proof.body}</p>
  {
    featured ? (
      // One case study: its approved numbers fill the row instead of empty space.
      <div class="mt-10 grid items-start gap-6 md:grid-cols-[22rem_1fr] md:gap-10">
        <CaseStudyCard t={t} entry={featured} />
        <div class="rounded-2xl bg-wash p-6 sm:p-8">
          <dl class="grid gap-6 sm:grid-cols-3">
            {featured.data.results.slice(0, 3).map((r) => (
              // Label first for screen readers; shown below the number.
              <div class="flex flex-col-reverse">
                <dt class="mt-1 text-muted">{r.label}</dt>
                <dd class="font-serif text-4xl font-bold sm:text-5xl">{r.value}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-6 text-sm text-muted">
            {featured.data.business}, {featured.data.location}. {t.caseStudy.source}
            {t.colon} {featured.data.results[0]?.source}
          </p>
        </div>
      </div>
    ) : (
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {entries.map((entry) => <CaseStudyCard t={t} entry={entry} />)}
      </div>
    )
  }
  {entries.length > 0 && <p class="mt-8"><a href={staticRoutes.work[locale]}>{proof.allWork}</a></p>}
</Section>
