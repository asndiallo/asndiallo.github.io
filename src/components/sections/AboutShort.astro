---
import { type Dictionary, type Locale, staticRoutes } from "../../i18n/index.ts";
import Portrait from "../Portrait.astro";
import Section from "../Section.astro";

interface Props {
  t: Dictionary;
  locale: Locale;
}
const { t, locale } = Astro.props;
const { about } = t.home;
---

<Section id="about" heading={about.h2}>
  <div class="mt-8 grid items-start gap-8 sm:grid-cols-[12rem_1fr] sm:gap-10">
    <div class="w-40 sm:w-48"><Portrait alt={t.photoAlt} size="sm" /></div>
    <div>
      <p class="measure text-lg">{about.body}</p>
      <p class="mt-4"><a href={staticRoutes.about[locale]}>{about.more}</a></p>
    </div>
  </div>
</Section>
