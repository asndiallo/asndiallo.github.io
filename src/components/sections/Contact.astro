---
import { site } from "../../config.ts";
import type { Dictionary } from "../../i18n/en.ts";
import { bookingHref, mailtoHref } from "../../lib/contact.ts";
import ContactForm from "../ContactForm.astro";
import CtaWhatsApp from "../CtaWhatsApp.astro";
import Section from "../Section.astro";
import Todo from "../Todo.astro";

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const mailto = mailtoHref();
const booking = bookingHref();
---

<Section id="contact" heading={t.home.contact.h2} band="brand">
  <p class="measure mt-4 text-lg">{t.home.contact.body}</p>
  <div class="mt-8"><CtaWhatsApp t={t} variant="inverse" /></div>
  <ul class="mt-6 space-y-2">
    <li>
      {t.cta.email}:{" "}
      {mailto ? <a href={mailto}>{site.email}</a> : <Todo label="email in src/config.ts" />}
    </li>
    <li>
      {booking ? <a href={booking}>{t.cta.booking}</a> : <>{t.cta.booking}: <Todo label="booking link in src/config.ts" /></>}
    </li>
  </ul>
  <ContactForm t={t} />
</Section>
