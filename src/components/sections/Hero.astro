---
import type { Dictionary } from "../../i18n/index.ts";
import { bookingHref } from "../../lib/contact.ts";
import CtaWhatsApp from "../CtaWhatsApp.astro";
import Link from "../Link.astro";
import Todo from "../Todo.astro";

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const { hero, listing } = t.home;
const booking = bookingHref();
---

<section aria-labelledby="hero-h" class="overflow-hidden">
  <div
    class="container-page grid items-center gap-12 py-12 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-16"
  >
    <div>
      <h1 id="hero-h" class="max-w-[18ch]">{hero.h1}</h1>
      <p class="measure mt-6 text-lg text-muted sm:text-xl">{hero.subhead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <CtaWhatsApp t={t} />
        {
          booking ? (
            <Link class="btn btn-secondary" href={booking}>
              {t.cta.booking}
            </Link>
          ) : (
            <span class="btn btn-secondary flex-col gap-1">
              {t.cta.booking}
              <Todo label="booking link in src/config.ts" />
            </span>
          )
        }
      </div>
      <p class="mt-4 text-muted">{hero.languages}</p>
    </div>

    <figure class="relative mx-auto w-full max-w-md">
      <!-- A street-grid "map" behind the listing: the point is being found nearby. -->
      <div
        aria-hidden="true"
        class="map-grid relative rounded-[2rem] bg-wash px-5 pt-16 pb-8 sm:px-8"
      >
        <svg
          class="absolute top-4 right-8 h-14 w-14"
          viewBox="0 0 48 48"
          role="presentation"
        >
          <path
            d="M24 3c-8.3 0-15 6.5-15 14.6C9 29 24 45 24 45s15-16 15-27.4C39 9.5 32.3 3 24 3z"
            fill="var(--color-sun)"
            stroke="var(--color-ink)"
            stroke-width="2"
          />
          <circle cx="24" cy="18" r="5.5" fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="2" />
        </svg>

        <div class="rounded-full border border-line bg-paper px-4 py-2.5 text-[0.95rem] text-muted shadow-sm">
          <svg aria-hidden="true" class="mr-2 inline h-4 w-4 align-[-2px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m20 20-4.8-4.8" /></svg>{listing.query}
        </div>

        <div class="mt-4 rounded-2xl border-2 border-ink bg-paper p-5 shadow-[6px_6px_0_var(--color-ink)]">
          <p class="text-lg font-bold">{listing.name}</p>
          <p class="text-[0.95rem] text-muted">{listing.category}</p>
          <p class="mt-2 flex items-center gap-1 text-[0.95rem]">
            <span class="tracking-[0.1em] text-sun">★★★★★</span>
            <span class="text-muted">{listing.reviews}</span>
          </p>
          <p class="mt-1 text-[0.95rem]">
            <span class="font-semibold text-brand">{listing.open}</span>
            <span class="text-muted"> · {listing.closes}</span>
          </p>
          <p class="mt-1 text-[0.95rem] text-muted">{listing.prices}</p>
          <div class="mt-4 grid grid-cols-3 gap-2">
            {
              listing.actions.map((action, i) => (
                <span
                  class:list={[
                    "rounded-full py-2 text-center text-sm font-semibold",
                    i === 0 ? "bg-brand text-on-brand" : "border border-line text-brand",
                  ]}
                >
                  {action}
                </span>
              ))
            }
          </div>
        </div>
      </div>
      <figcaption class="mt-3 text-sm text-muted">{listing.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .map-grid {
    background-image:
      linear-gradient(90deg, transparent 47%, var(--color-paper) 47%, var(--color-paper) 53%, transparent 53%),
      linear-gradient(0deg, transparent 47%, var(--color-paper) 47%, var(--color-paper) 53%, transparent 53%);
    background-size: 7.5rem 6rem;
    background-position: -1.5rem 1rem;
  }
</style>
