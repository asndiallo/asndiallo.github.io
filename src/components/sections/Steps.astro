---
import type { Dictionary } from "../../i18n/index.ts";
import Section from "../Section.astro";

interface Props {
  t: Dictionary;
}
const { steps } = Astro.props.t.home;
---

<Section id="how" heading={steps.h2}>
  <ol class="mt-10 grid gap-8 md:grid-cols-3">
    {
      steps.items.map((step, i) => (
        <li class="flex gap-4">
          <span aria-hidden="true" class="font-serif text-5xl leading-none font-bold text-brand">
            {i + 1}
          </span>
          <div>
            <h3>{step.title}</h3>
            <p class="mt-1 text-muted">{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
