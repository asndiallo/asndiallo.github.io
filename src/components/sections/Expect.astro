---
import type { Dictionary } from "../../i18n/en.ts";

interface Props {
  t: Dictionary;
}
const { expect } = Astro.props.t.home;
---

<section id="expect" aria-labelledby="expect-h" class="pb-16 sm:pb-24">
  <div class="container-page">
    <div class="measure border-l-8 border-sun pl-6">
      <h2 id="expect-h">{expect.h2}</h2>
      <p class="mt-4 text-lg">{expect.body}</p>
    </div>
  </div>
</section>
