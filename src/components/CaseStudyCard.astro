---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  headingLevel?: "h2" | "h3";
}
const { entry, headingLevel: Heading = "h3" } = Astro.props;
const { business, city, summary, image } = entry.data;
---

<article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-paper">
  {
    image && (
      <Image
        src={image.src}
        alt={image.alt}
        widths={[400, 800]}
        sizes="(min-width: 768px) 360px, 100vw"
        class="aspect-[16/10] w-full border-b border-line object-cover object-top"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <Heading class="text-xl">{business}</Heading>
    <p class="text-sm text-muted">{city}</p>
    <p class="mt-3 flex-1">{summary}</p>
    <a class="mt-4 font-semibold" href={`/work/${entry.id}/`}>Read the {business} case study</a>
  </div>
</article>
