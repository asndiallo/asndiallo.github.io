---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Dictionary } from "../i18n/index.ts";
import { entryPath } from "../lib/content.ts";

interface Props {
  t: Dictionary;
  entry: CollectionEntry<"work">;
  headingLevel?: "h2" | "h3";
  /** Load the image immediately (cards visible on first load). */
  eager?: boolean;
}
const { t, entry, headingLevel: Heading = "h3", eager = false } = Astro.props;
const { business, location, summary, image, status } = entry.data;
---

<article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-paper">
  {
    image && (
      <Image
        src={image.src}
        alt={image.alt}
        widths={[400, 800]}
        sizes="(min-width: 768px) 360px, 100vw"
        loading={eager ? "eager" : "lazy"}
        class="aspect-[16/10] w-full border-b border-line object-cover object-top"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    {
      status === "in-progress" && (
        <p class="mb-2 self-start rounded-full bg-sun/25 px-3 py-0.5 text-sm font-semibold">
          {t.caseStudy.inProgress}
        </p>
      )
    }
    <Heading class="text-xl">{business}</Heading>
    <p class="text-sm text-muted">{location}</p>
    <p class="mt-3 flex-1">{summary}</p>
    <a class="mt-4 font-semibold" href={entryPath("work", entry)}>{t.caseStudy.readMore(business)}</a>
  </div>
</article>
