---
import { site } from "../config.ts";
import Link from "./Link.astro";

interface Props {
  /** Accessible name for the list, in the page's language. */
  label: string;
}
const { label } = Astro.props;

/**
 * The business's own accounts, shown as pills in the footer's brand column. Assane's personal
 * profiles (LinkedIn, GitHub) are plain links beside the engineering work.
 * Lucide-style stroke icons, inlined so there is no dependency and no extra request.
 */
const networks = [
  {
    name: "Instagram",
    href: site.social.instagram,
    icon: `<rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>`,
  },
  {
    name: "Facebook",
    href: site.social.facebook,
    icon: `<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>`,
  },
];
---

<ul class="flex flex-wrap gap-2" aria-label={label}>
  {
    networks.map((n) => (
      <li>
        <Link
          href={n.href}
          rel="me"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-paper px-3.5 text-sm font-medium no-underline transition-colors hover:border-brand"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={n.icon}
          />
          {n.name}
        </Link>
      </li>
    ))
  }
</ul>
