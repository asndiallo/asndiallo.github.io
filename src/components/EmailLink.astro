---
import { encodedEmail } from "../lib/contact.ts";
import Todo from "./Todo.astro";

// Without JavaScript the link falls back to the contact section (WhatsApp, booking, form).
const encoded = encodedEmail();
---

{
  encoded ? (
    <>
      <a href="#contact" data-email={encoded}>
        <slot />
      </a>
      <script is:inline>
        for (const a of document.querySelectorAll("a[data-email]"))
          a.href = `mailto:${[...atob(a.dataset.email)].reverse().join("")}`;
      </script>
    </>
  ) : (
    <Todo label="email in src/config.ts" />
  )
}
