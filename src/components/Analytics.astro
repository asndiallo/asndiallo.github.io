---
import { PUBLIC_ANALYTICS, PUBLIC_CF_BEACON_TOKEN, PUBLIC_PLAUSIBLE_DOMAIN } from "astro:env/client";

// Cookieless analytics, off unless PUBLIC_ANALYTICS is set at build time.
const cloudflare = PUBLIC_ANALYTICS === "cloudflare" && PUBLIC_CF_BEACON_TOKEN;
const plausible = PUBLIC_ANALYTICS === "plausible" && PUBLIC_PLAUSIBLE_DOMAIN;
---

{
  cloudflare && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_BEACON_TOKEN })}
    />
  )
}
{
  plausible && (
    <script is:inline defer data-domain={PUBLIC_PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.js" />
  )
}
