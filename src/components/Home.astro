---
import { defaultLocale, getDictionary, type Locale, staticRoutes } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";
import { professionalServiceSchema } from "../lib/schema.ts";
import AboutShort from "./sections/AboutShort.astro";
import Contact from "./sections/Contact.astro";
import Expect from "./sections/Expect.astro";
import Faq from "./sections/Faq.astro";
import Hero from "./sections/Hero.astro";
import Pricing from "./sections/Pricing.astro";
import Problem from "./sections/Problem.astro";
import Proof from "./sections/Proof.astro";
import Services from "./sections/Services.astro";
import Steps from "./sections/Steps.astro";
import WhoFor from "./sections/WhoFor.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const { meta } = t.home;
---

<Base
  title={meta.title}
  description={meta.description}
  locale={locale}
  alternates={staticRoutes.home}
  detectLanguage={locale === defaultLocale}
  jsonLd={[professionalServiceSchema(meta.description)]}
>
  <Hero t={t} />
  <WhoFor t={t} locale={locale} />
  <Problem t={t} />
  <Services t={t} locale={locale} />
  <Steps t={t} />
  <Expect t={t} />
  <Proof t={t} locale={locale} />
  <Pricing t={t} />
  <AboutShort t={t} locale={locale} />
  <Faq t={t} />
  <Contact t={t} locale={locale} />
</Base>
