---
import CtaWhatsApp from "../components/CtaWhatsApp.astro";
import Todo from "../components/Todo.astro";
import { getDictionary } from "../i18n/index.ts";
import Page from "../layouts/Page.astro";
import { personSchema } from "../lib/schema.ts";

const t = getDictionary("en");
---

<Page
  title="About Assane Diallo | Local SEO in English & French"
  description="I'm Assane. I help African-owned businesses in the US get found on Google. Backend engineer, English and French. Je parle français."
  h1="About me"
  ogType="profile"
  jsonLd={[{ "@context": "https://schema.org", "@type": "ProfilePage", mainEntity: personSchema }]}
>
  <div class="mt-10 grid gap-12 lg:grid-cols-2">
    <section aria-labelledby="about-en" class="measure space-y-4 text-lg">
      <h2 id="about-en" class="text-2xl">In English</h2>
      <p>
        I'm Assane. I help African-owned businesses in the US get found on Google and get more calls
        and bookings.
      </p>
      <p>
        I'm a backend engineer with a Master's in Data Engineering & AI. I built and grew an
        SEO-driven ecommerce store to about 800 pages with no ad spend.
      </p>
      <p>I work in English and French, mostly over WhatsApp, so we don't have to schedule long meetings.</p>
      <p>
        Your accounts stay in your name. I'll always tell you what I'm doing, why, and what it did.
      </p>
      <p><Todo label="2–4 sentences in your own words: why this work matters to you" /></p>
    </section>

    <section lang="fr" aria-labelledby="about-fr" class="measure space-y-4 text-lg">
      <h2 id="about-fr" class="text-2xl">En français</h2>
      <p>
        Je m'appelle Assane. J'aide les entreprises africaines aux États-Unis à être trouvées sur
        Google et à recevoir plus d'appels et de réservations.
      </p>
      <p>
        Je suis ingénieur backend, avec un master en Data Engineering & IA. J'ai créé et développé une
        boutique en ligne d'environ 800 pages grâce au référencement naturel, sans publicité payante.
      </p>
      <p>Je travaille en français et en anglais, surtout sur WhatsApp.</p>
      <p>Vos comptes restent à votre nom. Je vous explique toujours ce que je fais, et pourquoi.</p>
      <p><Todo label="2–4 phrases avec vos propres mots" /></p>
    </section>
  </div>

  <p class="mt-12">
    Looking for my software work? See <a href="/engineering/">my engineering projects</a>.
  </p>
  <div class="mt-8"><CtaWhatsApp t={t} /></div>
</Page>
