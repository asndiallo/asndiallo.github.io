{
  // Cloudflare Workers static assets: no Worker script, Cloudflare serves dist/ directly.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "assane-diallo",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    // dist/404.html for unknown paths, with a real 404 status.
    "not_found_handling": "404-page",
    // /about → /about/ (Astro builds directory-style pages).
    "html_handling": "auto-trailing-slash"
  },
  // Preview phase: the site is reachable on workers.dev only, and every uploaded version gets
  // its own preview URL. At go-live the custom domain is added as a route and workers_dev is
  // turned off, so the site has exactly one public address.
  "workers_dev": true,
  "preview_urls": true
}
